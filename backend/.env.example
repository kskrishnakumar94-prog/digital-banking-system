PORT=5000
NODE_ENV=development

# Set to the number of reverse proxy hops in front of this server (e.g. 1
# for a single nginx/docker-compose frontend, or your cloud load balancer's
# hop count). Needed so rate limiting and audit logs see the real client IP
# from X-Forwarded-For instead of the proxy's own address.
TRUST_PROXY_HOPS=1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FA_APP_NAME=DigitalBank

# ---------------------------------------------------------------------
# Fraud detection thresholds
# ---------------------------------------------------------------------
LARGE_TXN_THRESHOLD=500000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
VELOCITY_WINDOW_MINUTES=10
VELOCITY_MAX_TXNS=5

# ---------------------------------------------------------------------
# Rate limiting (tunable per environment - see middleware/rateLimiter.js)
# ---------------------------------------------------------------------
# Login: hard cap on FAILED attempts only (successful logins never count)
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
# Progressive slow-down layered in front of the hard cap above - adds an
# increasing delay per extra attempt once AUTH_SLOWDOWN_AFTER is exceeded,
# so automated brute-force gets throttled well before the hard limit hits.
AUTH_SLOWDOWN_WINDOW_MIN=15
AUTH_SLOWDOWN_AFTER=3
AUTH_SLOWDOWN_DELAY_MS=500
# 2FA code verification: tighter cap since a 6-digit code has limited entropy
TWO_FA_RATE_LIMIT_WINDOW_MIN=15
TWO_FA_RATE_LIMIT_MAX=10
# General API ceiling (all routes)
API_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=300
# Fund transfers: tight cap since each request moves money
TRANSFER_RATE_LIMIT_WINDOW_MIN=5
TRANSFER_RATE_LIMIT_MAX=15

# ---------------------------------------------------------------------
# Email alerts (nodemailer/SMTP)
# Leave SMTP_HOST blank to fall back to console/log-only "sending" - handy
# for local dev without a real mail server. Fill it in for real delivery.
# ---------------------------------------------------------------------
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="DigitalBank Alerts <alerts@example.com>"

# ---------------------------------------------------------------------
# SMS alerts
# SMS_PROVIDER=console just logs the message (zero setup, safe default).
# SMS_PROVIDER=twilio sends a real SMS - run `npm install twilio` in
# /backend first, then fill in the Twilio credentials below.
# ---------------------------------------------------------------------
SMS_ALERTS_ENABLED=false
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Send a receipt email/SMS to both parties after every fund transfer
TRANSFER_RECEIPT_ENABLED=true

# ---------------------------------------------------------------------
# Scheduled / recurring transfers (backend/utils/scheduler.js)
# ---------------------------------------------------------------------
# How often the background worker checks for due scheduled transfers
SCHEDULER_INTERVAL_MS=60000
# After this many consecutive failed attempts, a scheduled/recurring
# transfer is auto-paused (and its owner notified) instead of retried forever
MAX_SCHEDULED_TRANSFER_FAILURES=5

# ---------------------------------------------------------------------
# Idempotency keys (middleware/idempotency.js) - protects POST /transfers
# against duplicate execution on client retries
# ---------------------------------------------------------------------
# An idempotency row stuck "in flight" longer than this (e.g. the original
# request crashed before responding) is treated as abandoned, so a retry
# isn't blocked forever
IDEMPOTENCY_STALE_MS=60000
